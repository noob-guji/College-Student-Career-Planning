# Database
DATABASE_URL="file:./dev.db"
AUTH_SECRET="your-random-secret-key-here"

# ══ AI Provider Configuration ══
# Choose one of: mock / tongyi / wenxin / chatglm / xunfei / openai

# Option 1: Tongyi QianWen (Recommended - stable, free tier available)
# AI_PROVIDER=tongyi
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=qwen-plus
# Apply at: https://dashscope.aliyun.com → Console → API-KEY Management

# Option 2: Zhipu ChatGLM (Free tier available)
# AI_PROVIDER=chatglm
# ZHIPU_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxx
# AI_MODEL=glm-4
# Apply at: https://open.bigmodel.cn → API Keys

# Option 3: Baidu Wenxin (ERNIE Bot)
# AI_PROVIDER=wenxin
# WENXIN_API_KEY=your-api-key-here
# WENXIN_SECRET_KEY=your-secret-key-here
# AI_MODEL=ernie-5.0
# Apply at: https://console.bce.baidu.com → Qianfan Model Platform

# Option 4: Xunfei Spark
# AI_PROVIDER=xunfei
# XUNFEI_API_KEY=Bearer xxxxxxxxxxxxxxxx
# AI_MODEL=generalv3.5
# Apply at: https://xinghuo.xfyun.cn → Console

# Option 5: DeepSeek (Lowest price)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Default: mock (local simulation, no API key needed)
AI_PROVIDER=mock
AI_MODEL=mock
